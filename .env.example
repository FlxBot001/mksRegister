# Copy to .env.local. Never commit real values.
# Get both values from your Supabase project settings.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key\n# Required only for securely accepting invitations and provisioning memberships. Keep server-side only.\nSUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_APP_NAME=MKS Register
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas: use a least-privilege database user and keep this URI secret.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mks_register
MONGODB_MAX_POOL_SIZE=10
APP_BASE_URL=http://localhost:3000

# Only for the one-time `npm run bootstrap:admin` command. Never commit real values.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_FULL_NAME=Workspace Administrator
ADMIN_TENANT_NAME=My Organization
ADMIN_TENANT_SLUG=my-organization
