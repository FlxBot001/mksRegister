# Copy to .env.local. Never commit real values.
# MongoDB is the only application database and identity/session store.
# Use a dedicated least-privilege database user; URL-encode special characters.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mks_register
MONGODB_MAX_POOL_SIZE=10

# Generate independent random secrets (at least 32 characters each).
# AUTH_ENCRYPTION_KEY encrypts TOTP authenticator secrets at rest.
AUTH_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
# AUTH_AUDIT_HASH_SECRET keys hashes in security event and rate-limit records.
AUTH_AUDIT_HASH_SECRET=replace-with-another-random-secret-at-least-32-characters

NEXT_PUBLIC_APP_NAME=MKS Register
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Optional email delivery for password recovery. Without these values, reset tokens
# are created but no email can be delivered; configure before enabling recovery in production.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
