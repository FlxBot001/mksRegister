# Copy to .env.local. Never commit real values.
# Supabase Auth and tenant membership remain in use in this transitional architecture.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only secret for invitation acceptance and one-time admin provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

NEXT_PUBLIC_APP_NAME=MKS Register
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# MongoDB Atlas: create a least-privilege application user and restrict network access.
# URL-encode special characters in username/password. Never expose this value to the browser.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mks_register
MONGODB_MAX_POOL_SIZE=10

# One-time bootstrap only: set privately before running npm run bootstrap:admin.
# Remove these from the environment after provisioning; do not commit real values.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_FULL_NAME=Workspace Administrator
ADMIN_TENANT_NAME=My Organization
ADMIN_TENANT_SLUG=my-organization
