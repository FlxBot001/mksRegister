# Copy to .env.local. Never commit real values.
# Get both values from your Supabase project settings.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_NAME=MKS Register
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas: use a least-privilege database user and keep this URI secret.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mks_register
MONGODB_MAX_POOL_SIZE=10
APP_BASE_URL=http://localhost:3000
